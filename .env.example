# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://avetcare.ae

# Google Search Console → Add property → URL prefix → "HTML tag" method.
# Paste only the content="..." value, e.g. abc123XYZ
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Where contact-form submissions are POSTed (e.g. a Zapier/Make/Slack webhook)
CONTACT_WEBHOOK_URL=
